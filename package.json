{
  "name": "ledger",
  "version": "1.0.0",
  "description": "A private, offline-first personal finance app for iOS, Android and the web.",
  "license": "MIT",
  "author": "reyi06 (https://github.com/reyi06)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reyi06/ledger.git"
  },
  "homepage": "https://github.com/reyi06/ledger#readme",
